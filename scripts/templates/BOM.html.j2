<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Bill of Materials</title>
    <style>
        @page {
            size: A4 portrait;
            margin: 2cm;
            @bottom-center {
                content: "Page " counter(page) " of " counter(pages);
                font-size: 10px;
                color: #999;
            }
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 12px;
            color: #333;
        }

        h1, h2 {
            text-align: center;
            margin-bottom: 0.5em;
        }

        .date {
            text-align: center;
            margin-bottom: 1em;
            font-size: 11px;
            color: #666;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 1em;
        }

        th, td {
            border: 1px solid #666;
            padding: 6px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }
    </style>
</head>
<body>

    <h1>Bill of Materials</h1>
    <div class="date">Generated on {{ date }}</div>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Material ref</th>
                <th>Description</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Url</th>
                <th>Parts</th>
            </tr>
        </thead>
        <tbody>
            {% for material in materials %}
            <tr>
                <td>{{ loop.index }}</td>
                <td>{{ material.ref }}</td>
                <td>{{ material.id }}</td>
                <td>{{ material.quantity }}</td>
                <td>{{ material.unit }}</td>
                <td><a href="{{ material.url }}">{{ material.url }}</a></td>
                <td>{{ material.parts }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

</body>
</html>